# MongoDB Atlas connection string. Required everywhere (app + seed script).
MONGODB_URI=

# NextAuth session/JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used for SEO (metadataBase, sitemap, Open Graph). Defaults to the
# production Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=

# Google OAuth (optional sign-in provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (product image uploads, /api/media/upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email — password reset). Free tier can only send to
# the account's own verified email until a sending domain is verified.
RESEND_API_KEY=
EMAIL_FROM=

# --- scripts/seed.ts only (never read by the app itself) ---
# Optional overrides for the seeded admin account. If ADMIN_SEED_PASSWORD is
# left unset, the seed script generates a random one and prints it once —
# it is never hardcoded, since this repo is public.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# scripts/rotate-admin-password.ts only: set temporarily in .env.local (never
# commit), run `npm run rotate-admin`, then delete it. Min 12 characters.
ADMIN_NEW_PASSWORD=
